{
  "name": "repo-health-cli",
  "version": "0.3.0",
  "description": "A TypeScript CLI for auditing open-source repository readiness.",
  "type": "module",
  "packageManager": "npm@10.9.9",
  "bin": {
    "repo-health": "./bin/repo-health.js"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./multi": {
      "types": "./dist/multi/index.d.ts",
      "import": "./dist/multi/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TurkiAls/repo-health-cli.git"
  },
  "bugs": {
    "url": "https://github.com/TurkiAls/repo-health-cli/issues"
  },
  "homepage": "https://github.com/TurkiAls/repo-health-cli#readme",
  "files": [
    "bin",
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "test": "vitest run",
    "lint": "eslint src tests --ext .ts",
    "demo": "tsx src/cli.ts scan examples/incomplete-repo --markdown"
  },
  "keywords": [
    "cli",
    "open-source",
    "repository-health",
    "maintainers",
    "multi-repo",
    "security"
  ],
  "author": "Turki Als",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
